{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.35.1.17967",
      "templateHash": "8405465304740654367"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "copilottips",
      "minLength": 3,
      "maxLength": 20,
      "metadata": {
        "description": "Base name for all resources. Lowercase alphanumeric, 3–20 chars."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "appServiceSkuName": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "P0v3",
        "P1v3",
        "P2v3"
      ],
      "metadata": {
        "description": "App Service SKU. B1 for dev/demo; P1v3 for production."
      }
    },
    "nodeVersion": {
      "type": "string",
      "defaultValue": "NODE|20-lts",
      "metadata": {
        "description": "Node.js runtime version."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "staging",
        "prod"
      ],
      "metadata": {
        "description": "Environment tag (dev, staging, prod)."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id, parameters('appName'))]",
    "planName": "[format('plan-{0}-{1}', parameters('appName'), parameters('environment'))]",
    "webAppName": "[format('app-{0}-{1}-{2}', parameters('appName'), parameters('environment'), variables('uniqueSuffix'))]",
    "lawName": "[format('law-{0}-{1}', parameters('appName'), parameters('environment'))]",
    "appInsName": "[format('appi-{0}-{1}', parameters('appName'), parameters('environment'))]",
    "commonTags": {
      "application": "[parameters('appName')]",
      "environment": "[parameters('environment')]",
      "managedBy": "bicep",
      "costCenter": "demo"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('lawName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[variables('commonTags')]",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('lawName'))]",
        "IngestionMode": "LogAnalytics",
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('lawName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('appServiceSkuName')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('webAppName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[parameters('nodeVersion')]",
          "nodeVersion": "[parameters('nodeVersion')]",
          "alwaysOn": "[not(equals(parameters('appServiceSkuName'), 'B1'))]",
          "ftpsState": "Disabled",
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "healthCheckPath": "/api/tips",
          "appCommandLine": "node server.js",
          "appSettings": [
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsName')), '2020-02-02').InstrumentationKey]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "ApplicationInsightsAgent_EXTENSION_VERSION",
              "value": "~3"
            },
            {
              "name": "NODE_ENV",
              "value": "[if(equals(parameters('environment'), 'prod'), 'production', 'development')]"
            },
            {
              "name": "PORT",
              "value": "8080"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~20"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appInsName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ]
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "metadata": {
        "description": "The public URL of the deployed web app."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2023-12-01').defaultHostName)]"
    },
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "The resource name of the web app (needed for az webapp deploy)."
      },
      "value": "[variables('webAppName')]"
    },
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "The resource group the app was deployed into."
      },
      "value": "[resourceGroup().name]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "metadata": {
        "description": "Application Insights connection string."
      },
      "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsName')), '2020-02-02').ConnectionString]"
    },
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "Managed Identity principal ID (for RBAC assignments)."
      },
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2023-12-01', 'full').identity.principalId]"
    }
  }
}